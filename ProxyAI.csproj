<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OneProviderProxy</RootNamespace>
    <!-- PerMonitorV2: il layout usa Dock/TableLayoutPanel, quindi deve scalare con il monitor. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <!-- Da qui parte il versioning: aggiornare qui e nel tag Git (vMAJOR.MINOR.PATCH). -->
    <Version>1.1.0</Version>
    <Product>ProxyAI</Product>
    <Copyright>Copyright (c) 2026 mgiane86</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

</Project>